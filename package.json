{
    "name": "lcjs-wasm-memory64-demo",
    "private": true,
    "version": "1.0.0",
    "description": "LightningChart JS demo: a ~28 GB, 7-billion-point motorsport telemetry archive in one shared DataSet using WebAssembly Memory64 (Electron desktop app)",
    "main": "electron/main.cjs",
    "scripts": {
        "start": "vite build && electron .",
        "typecheck": "tsc --noEmit",
        "package": "vite build && electron-packager . Season-Telemetry-Archive --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"^/(src|release|index.html|vite.config.ts|tsconfig.json|package-lock.json)\""
    },
    "devDependencies": {
        "@electron/packager": "^20.3.0",
        "@lightningchart/lcjs": "^9.1.0",
        "electron": "^41.0.0",
        "typescript": "^5.6.0",
        "vite": "^7.0.0"
    }
}
